# 식당OS(resturant_os) storefront 베이스 URL (끝에 / 없음).
# 관리자OS 상품관리「스토어 미리보기」가 /buy·/buy/products/[id] 를 iframe으로 불러올 때 사용합니다.
# dev: resturant_os 를 예) 3001 포트에서 띄운 뒤 동일 값으로 맞춥니다.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3001

# 식당OS 푸시 발송 API (restaurant_os INTERNAL_API_KEY와 동일 값)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dfaith0308@gmail.com
INTERNAL_API_KEY=

# 솔라피 SMS (실발송) — 알리고 대체
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 토스페이먼츠 구독 결제 (빌링)
# 첫 결제(/api/toss/billing)와 매달 자동 재청구(/api/cron/billing-renewal)가 함께 쓴다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 구독 자동 재청구 크론 인증 (/api/cron/billing-renewal)
# Vercel 프로젝트 환경변수에 넣으면 Vercel Cron 이 Authorization: Bearer <값> 으로 호출한다.
# 값이 없으면 라우트가 500 으로 실행을 거부한다 — 공개 결제 트리거가 되는 것을 막기 위함.
CRON_SECRET=
